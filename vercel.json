{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "daily-sync": {
      "schedule": "0 9 * * *",
      "timezone": "America/New_York",
      "path": "/api/cron/sync",
      "requestMethod": "GET"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/cron/).*)",
      "has": [
        {
          "type": "host",
          "value": "collection-tracker-chi.vercel.app"
        }
      ],
      "destination": "https://jonathanwmendez-collection-tracker.vercel.app/:path",
      "permanent": true
    }
  ]
}
