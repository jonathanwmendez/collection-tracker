# Copy this file to .env.local for local development, and add the same values in Vercel.
# Never commit real values.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Owners: Google accounts that can always sign in and manage access on the Admin page, comma-separated.
# Everyone else is invited from the Admin page. (ALLOWED_EMAILS, the older name, still works.)
ADMIN_EMAILS=you@example.com

# Google OAuth client (Google Auth Platform > Clients). The server uses these to keep
# Sheets and Drive access working between sign-ins. The secret is server only.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Optional: raises the Pokémon TCG API's rate limit for free card price checks.
POKEMONTCG_API_KEY=

# Optional: typical eBay asking prices for sports cards (eBay developer account, Production keyset).
# App ID goes in EBAY_CLIENT_ID, Cert ID in EBAY_CLIENT_SECRET. Server only.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# A long random string. Vercel sends it to the daily sync job so only Vercel can run it.
CRON_SECRET=
